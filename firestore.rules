rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {

    // names/{tên chuẩn hoá}: giữ chỗ tên, mỗi tên chỉ tạo được 1 lần, không sửa.
    // Chỉ chủ tên mới xoá được (để đổi tên), và chỉ khi hồ sơ của chính họ không còn dùng tên đó:
    // đổi tên = xoá tên cũ + tạo tên mới + sửa players/{uid} trong cùng một transaction.
    match /names/{k} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(d)/documents/players/$(request.auth.uid)).data.nk != k;
    }

    // players/{uid}: hồ sơ + điểm. Chỉ chủ tài khoản được ghi.
    match /players/{u} {
      allow read: if true;

      allow create: if request.auth != null && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['uid', 'name', 'nk', 'guest', 'xp', 'stars', 'streak', 'updatedAt'])
        && request.resource.data.uid == u
        && getAfter(/databases/$(d)/documents/names/$(request.resource.data.nk)).data.uid == u
        && request.resource.data.xp == 0
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 16;

      // Không giảm XP, mỗi lượt chơi cộng tối đa 250 XP
      // (lượt cao nhất trong game là 200 XP). Không giới hạn XP theo ngày.
      // Đổi tên được, với điều kiện: tên 2–16 ký tự; nếu tên chuẩn hoá (nk) đổi thì phải giữ chỗ
      // names/{nk mới} cho chính mình và nhả names/{nk cũ} trong cùng giao dịch.
      // 'dk' và 'dxp' là trường cũ của bản v6 (đếm XP/ngày), giữ trong danh sách
      // để hồ sơ đã ghi bằng bản v6 vẫn cập nhật được.
      allow update: if request.auth != null && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['uid', 'name', 'nk', 'guest', 'xp', 'stars', 'streak', 'updatedAt', 'dk', 'dxp'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp - resource.data.xp <= 250
        && request.resource.data.stars <= 300
        && (
          // lượt chơi bình thường: không đụng tới tên
          (request.resource.data.name == resource.data.name
            && request.resource.data.nk == resource.data.nk)
          // đổi tên
          || (request.resource.data.name is string
            && request.resource.data.name.size() >= 2
            && request.resource.data.name.size() <= 16
            && (request.resource.data.nk == resource.data.nk
              || (getAfter(/databases/$(d)/documents/names/$(request.resource.data.nk)).data.uid == u
                && !existsAfter(/databases/$(d)/documents/names/$(resource.data.nk)))))
        );
    }

    // progress/{uid}: tiến độ học (sao từng chủ đề, độ chính xác, thử thách ngày: dc = lớp 6, dc7, dc8, dc9 = lớp 7, 8, 9, chuỗi ngày)
    // để đồng bộ giữa các máy. Chỉ chủ tài khoản đọc/ghi. XP vẫn nằm ở players/{uid} (có chặn cộng quá 250/lượt).
    match /progress/{u} {
      allow read: if request.auth != null && request.auth.uid == u;
      allow create, update: if request.auth != null && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['b', 'acc', 'dc', 'dc7', 'dc8', 'dc9', 'st', 'day', 'updatedAt'])
        && request.resource.data.b is map && request.resource.data.b.size() <= 200
        && request.resource.data.acc is map && request.resource.data.acc.size() <= 200;
    }
  }
}
